# Copy to .env and fill in values. Never commit .env.

# LLM
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# OPENAI_API_KEY=your-openai-api-key

# Auth
JWT_SECRET=replace-with-a-long-random-string
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_ENCRYPTION_KEY=replace-with-fernet-key

# Admin dashboard
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Matching
TOP_N_MATCHES=3
DELEGATE_MAX_CLARIFY=2
CONSENT_TIMEOUT=120
ACCEPT_TIMEOUT=120

# GitHub App (repo integration — optional)
# Create at https://github.com/settings/apps
# Required permissions: Contents (read), Pull requests (read+write), Issues (read+write)
# Callback URL: https://yourdomain.com/api/github/app/callback
# GITHUB_APP_ID=123456
# GITHUB_APP_NAME=your-app-slug
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem
# GITHUB_APP_PRIVATE_KEY=      # alternative: paste PEM with \n for newlines
# GITHUB_MARKETPLACE_WEBHOOK_SECRET=   # generate: python -c "import secrets; print(secrets.token_hex(32))"

# Database & logging
USER_DB_PATH=data/users.db
LOG_LEVEL=INFO
LOG_FILE=logs/service.log
